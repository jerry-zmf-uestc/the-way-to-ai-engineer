---
import type { CollectionEntry } from 'astro:content';
import ChapterCard from './ChapterCard.astro';
interface Props { pages: CollectionEntry<'chapters'>[]; headingLevel?: 3 | 4 | 5 }
const { pages, headingLevel = 3 } = Astro.props;
---

<div class="chapter-grid">
  {pages.map((entry) => (
    <ChapterCard
      id={entry.id}
      title={entry.data.title}
      description={entry.data.description}
      part={entry.data.navigationPath?.at(-1) ?? entry.data.part}
      capabilities={entry.data.capabilities}
      labs={entry.data.labs}
      headingLevel={headingLevel}
      unitNumber={entry.data.unitNumber}
    />
  ))}
</div>
