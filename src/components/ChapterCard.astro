---
interface Props {
  id: string;
  title: string;
  description: string;
  part: string;
  capabilities: string[];
  labs: string[];
  headingLevel?: 3 | 4 | 5;
  unitNumber?: number;
}

const { id, title, description, part, capabilities, labs, headingLevel = 3, unitNumber } = Astro.props;
const Heading = `h${headingLevel}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article class="chapter-card">
  <a class="card-link" href={`${base}/chapters/${id}/`}>
    <span class="card-part">{part}</span>
    {unitNumber && !title.startsWith('第 ') && <span class="unit-number">第 {unitNumber} 单元</span>}
    <Heading class="card-title">{title}</Heading>
    <p>{description}</p>
    <div class="card-meta">
      {capabilities.map((capability) => <span class="tag">{capability}</span>)}
    </div>
    {labs.length > 0 && <span class="lab-count">{labs.length} 个可运行 Lab</span>}
    <span class="card-arrow" aria-hidden="true">阅读全文 →</span>
  </a>
</article>
