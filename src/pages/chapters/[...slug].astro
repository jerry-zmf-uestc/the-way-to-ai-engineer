---
import { getCollection, render } from 'astro:content';
import ChapterLayout from '../../layouts/ChapterLayout.astro';
import redirects from '../../../content/book/redirects.json';
import { SITE_BASE } from '../../../scripts/book-content.mjs';

export async function getStaticPaths() {
  const entries = (await getCollection('chapters', ({ data }) => data.published))
    .sort((left, right) => left.data.order - right.data.order);

  const chapters = entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previous: index > 0 ? { id: entries[index - 1].id, title: entries[index - 1].data.title } : undefined,
      next: index + 1 < entries.length ? { id: entries[index + 1].id, title: entries[index + 1].data.title } : undefined,
    },
  }));
  const aliases = Object.entries(redirects).map(([id, target]) => ({
    params: { slug: id },
    props: { redirect: { id, ...target } },
  }));
  return [...chapters, ...aliases];
}

const { entry, previous, next, redirect } = Astro.props;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const headings = rendered?.headings;
const destination = redirect ? `${SITE_BASE}/chapters/${redirect.pageId}/#${redirect.anchor}` : undefined;
---

{redirect ? (
  <html lang="zh-CN">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width" />
      <title>章节已整合</title>
      <link rel="canonical" href={new URL(destination!, Astro.site)} />
      <meta name="robots" content="noindex" />
      <meta http-equiv="refresh" content={`0;url=${destination}`} />
    </head>
    <body>
      <p>本主题已整合到新章节。<a id="chapter-destination" href={destination}>继续阅读</a></p>
      <script is:inline>
        const link = document.getElementById('chapter-destination');
        const destination = new URL(link.href);
        if (window.location.hash) destination.hash = window.location.hash;
        link.href = destination.href;
        window.location.replace(destination.href);
      </script>
    </body>
  </html>
) : Content && (
<ChapterLayout
  pageId={entry.id}
  unitNumber={entry.data.unitNumber}
  title={entry.data.title}
  description={entry.data.description}
  part={entry.data.part}
  source={entry.data.source}
  capabilities={entry.data.capabilities}
  labs={entry.data.labs}
  headings={headings}
  previous={previous}
  next={next}
>
  <Content />
</ChapterLayout>
)}
