---
import { getCollection, render } from 'astro:content';
import ChapterLayout from '../../layouts/ChapterLayout.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('chapters', ({ data }) => data.published))
    .sort((left, right) => left.data.order - right.data.order);

  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previous: index > 0 ? { id: entries[index - 1].id, title: entries[index - 1].data.title } : undefined,
      next: index + 1 < entries.length ? { id: entries[index + 1].id, title: entries[index + 1].data.title } : undefined,
    },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<ChapterLayout
  title={entry.data.title}
  description={entry.data.description}
  part={entry.data.part}
  source={entry.data.source}
  capabilities={entry.data.capabilities}
  labs={entry.data.labs}
  headings={headings}
  previous={previous}
  next={next}
>
  <Content />
</ChapterLayout>
